          {
            address: "grpc://localhost:50051",
          },
        ],
        store_type: "cas",
      },
    },
    {
      name: "GRPC_LOCAL_AC_STORE",
      grpc: {
        instance_name: "",
        endpoints: [
          {
            address: "grpc://localhost:50051",
          },
        ],
        store_type: "ac",
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "/tmp/worker-data/content_path-cas",
            temp_path: "/tmp/worker-data/tmp_path-cas",
            eviction_policy: {
              max_bytes: 10000000000,
            },
          },
        },
        fast_direction: "get",
        slow: {
          ref_store: {
            name: "GRPC_LOCAL_STORE",
          },
        },
      },
    },
  ],
  workers: [
    {
      local: {
        entrypoint: "/Users/edwardbeech/Projects/Home/nativelink/deployment-examples/initialed85/job-entrypoint.sh",
        worker_api_endpoint: {
